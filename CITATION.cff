cff-version: 1.2.0
message: >-
  If you use this software, please cite both the software and the essay it
  implements.
title: "lat — Language as a Tool"
abstract: >-
  A local, read-only Model Context Protocol (MCP) server that serves a curated
  catalogue of natural-language and poetic "thinking patterns", classified by a
  closed set of cognitive axes, for reframing a problem through a contrasting
  language or form.
type: software
version: "0.2.3"
date-released: "2026-08-11"
license: Apache-2.0
# Concept DOI ("cite all versions"): stable across releases and always resolves
# to the newest version. This is the DOI to cite for the software as such.
doi: 10.5281/zenodo.21508868
# Version DOIs of the individual releases, newest first. Each has a relation
# childOf the concept DOI in the doi field above. Add one entry per release;
# 0.2.3 receives its own version DOI when it is deposited.
identifiers:
  - type: doi
    value: 10.5281/zenodo.21890295
    description: "Version DOI of release 0.2.2."
  - type: doi
    value: 10.5281/zenodo.21869711
    description: "Version DOI of release 0.2.1."
  - type: doi
    value: 10.5281/zenodo.21853807
    description: "Version DOI of release 0.2.0."
  - type: doi
    value: 10.5281/zenodo.21508869
    description: "Version DOI of release 0.1.0."
authors:
  - family-names: Schlifka
    given-names: Dana
repository-code: "https://github.com/nyadyme/lat"
url: "https://github.com/nyadyme/lat"
keywords:
  - MCP
  - Model Context Protocol
  - linguistic relativity
  - reframing
  - thinking tools
  - prior art

# The essay this software implements — canonical, timestamped deposits.
references:
  - type: article
    title: "Language as a Tool of Thought"
    authors:
      - family-names: Schlifka
        given-names: Dana
    year: 2026
